<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    <RootNamespace>Plugin.Maui.Observability</RootNamespace>
    <AssemblyName>Plugin.Maui.Observability</AssemblyName>
    <PackageId>Plugin.Maui.Observability</PackageId>
    <Title>.NET MAUI Observability — umbrella telemetry pipeline</Title>
    <Description>Umbrella telemetry pipeline for .NET MAUI on iOS and Android. Unifies AppHealth, NetworkMonitor, ApiResilience, BackgroundTasks, OfflineSync, SmartUpload, and DeviceSession into one signal stream, and exports to OpenTelemetry, Application Insights, Sentry, Datadog, Console, or a custom HTTP endpoint.</Description>
    <PackageTags>dotnet-maui;maui;maui-plugin;maui-utilities;cross-platform;android;ios;nuget;mauiessentials;observability;telemetry;logging;metrics;tracing;export;umbrella</PackageTags>
    <Authors>Niladri</Authors>
    <Company>MauiEssentials</Company>
    <Copyright>Copyright © 2026 Niladri</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://nuvyntralabs.github.io/packages/plugin-maui-observability/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nuvyntralabs/Plugin.Maui.Observability</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.6</Version>
    <PackageReleaseNotes>Point PackageProjectUrl at the Nuvyntra Labs package page.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AppHealth\src\Plugin.Maui.AppHealth\Plugin.Maui.AppHealth.csproj" />
    <ProjectReference Include="..\..\..\NetworkMonitor\src\Maui.NetworkMonitor\Maui.NetworkMonitor.csproj" />
    <ProjectReference Include="..\..\..\ApiResilience\src\Plugin.Maui.ApiResilience\Plugin.Maui.ApiResilience.csproj" />
    <ProjectReference Include="..\..\..\BackgroundTasks\src\Plugin.Maui.BackgroundTasks\Plugin.Maui.BackgroundTasks.csproj" />
    <ProjectReference Include="..\..\..\OfflineSync\src\Plugin.Maui.OfflineSync\Plugin.Maui.OfflineSync.csproj" />
    <ProjectReference Include="..\..\..\SmartUpload\src\Plugin.Maui.SmartUpload\Plugin.Maui.SmartUpload.csproj" />
    <ProjectReference Include="..\..\..\DeviceSession\src\Plugin.Maui.DeviceSession\Plugin.Maui.DeviceSession.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.Maui.Observability.Tests" />
  </ItemGroup>

</Project>
